function drawPattern(b, v)
{
	for var x in 1:50 do
	{
		for var y in 1:50 do
		{
			var square = check(x, y, b, v);
			if square then canvas.fillRect(10*x, 10*y, 10, 10);
		}
	}
}


# x^y mod b = v
function check(x, y, b, v) {
	if y == 0 then return 1;

	var acc = 1;
	for var i in 0:y do {
		acc *= x;
		acc %= b;
	}

	return acc == v;
}

drawPattern(18, 1);
